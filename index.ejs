    <script>
      // Прямой обработчик для кнопки "Перейти к медиа"
      (function () {
        function initGoToMediaButton() {
          const goToMediaBtn = document.querySelector(
            '.widget-item[data-tab="media"]',
          );

          if (goToMediaBtn) {
            // Удаляем старый обработчик, если был
            goToMediaBtn.removeEventListener("click", window.goToMediaHandler);

            // Создаем новый обработчик
            window.goToMediaHandler = function () {
              // Находим вкладку медиа
              const mediaTab = document.querySelector(
                '.sidebar-tab[data-tab="media"]',
              );

              if (mediaTab) {
                // Активируем вкладку
                mediaTab.click();

                // Обновляем заголовок панели
                const panelTitle = document.getElementById(
                  "widgets-panel-title",
                );
                if (panelTitle) {
                  panelTitle.textContent = "Медиа";
                }

                // Раскрываем все секции в медиа-вкладке
                setTimeout(() => {
                  const sections = [
                    "media-upload-section",
                    "media-library-section",
                    "media-player-section",
                  ];

                  sections.forEach((sectionId) => {
                    const section = document.getElementById(sectionId);
                    const toggle = document.querySelector(
                      `[data-target="${sectionId}"] .section-toggle`,
                    );

                    if (section && section.classList.contains("collapsed")) {
                      section.classList.remove("collapsed");
                      if (toggle) toggle.textContent = "−";
                    }
                  });

                  // Автоматически загружаем список файлов
                  if (window.mediaManager) {
                    window.mediaManager.loadMediaFiles();
                  }

                  // Показываем уведомление
                  console.log("Переход в медиатеку");
                }, 100);
              }
            };

            // Добавляем обработчик
            goToMediaBtn.addEventListener("click", window.goToMediaHandler);

            // Добавляем визуальный эффект при наведении
            goToMediaBtn.style.transition = "all 0.3s ease";
            goToMediaBtn.style.border = "2px solid var(--accent-primary)";
