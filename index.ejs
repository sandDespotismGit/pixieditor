                      // Вертикальные: все PNG
                      const track =
                        document.getElementById("bg-carousel-track");
                      const totalSlidesSpan =
                        document.getElementById("bg-total-slides");

                      if (track) {
                        let visibleCount = 0;
                        let firstVisible = -1;

                        for (let i = 0; i < track.children.length; i++) {
                          const img = track.children[i].querySelector("img");
                          // Вертикальные: bg-1,2,9,10,12,13,18,20,25
                          const portraitIds = [
                            "bg-1",
                            "bg-2",
                            "bg-9",
                            "bg-10",
                            "bg-12",
                            "bg-13",
                            "bg-18",
                            "bg-20",
                            "bg-25",
                          ];

                          if (img && portraitIds.includes(img.id)) {
                            track.children[i].style.display = "flex";
                            visibleCount++;
                            if (firstVisible === -1) firstVisible = i;
                          } else {
                            track.children[i].style.display = "none";
                          }
                        }

                        if (totalSlidesSpan) {
                          totalSlidesSpan.textContent = visibleCount;
                        }

                        if (firstVisible !== -1) {
                          const dot = document.querySelector(
                            `.carousel-dot[data-index="${firstVisible}"]`,
                          );
                          if (dot) dot.click();
                        }
                      }
                    };
