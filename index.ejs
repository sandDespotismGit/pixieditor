        async deleteSelectedFiles() {
          const filesToDelete = Array.from(this.selectedFiles);
          if (filesToDelete.length === 0) return;

          // Показываем подтверждение для нескольких файлов
          if (filesToDelete.length > 1) {
            if (!confirm(`Удалить ${filesToDelete.length} выбранных файлов?`)) {
              return;
            }
          }

          try {
            const results = await Promise.allSettled(
              filesToDelete.map((filename) => this.deleteFile(filename)),
            );

            const successful = results.filter(
              (r) => r.status === "fulfilled",
            ).length;
            const failed = results.filter(
              (r) => r.status === "rejected",
            ).length;

            if (failed > 0) {
              showNotification(
                "warning",
                `Удалено ${successful} файлов, ошибок: ${failed}`,
              );
            } else {
              showNotification(
                "success",
                `Успешно удалено ${successful} файлов`,
              );
            }

            // Обновляем список
            this.loadMediaFiles();
            this.selectedFiles.clear();
          } catch (error) {
            console.error("Ошибка удаления:", error);
            showNotification("error", "Ошибка при удалении файлов");
          }
        }

        async deleteFile(id) {
          console.log("id", id);
          // 1. находим удаляемый файл
          const filteredFile = this.data?.find((item) => item?.id == id);
          console.log("filtered file", filteredFile);

          // 2. находим файлы, которые стояли по позиции после удаляемого файла
          const filteredFilesToUpload = this.data?.filter(
            (item) =>
              item?.position > filteredFile?.position &&
              item?.type === filteredFile?.type &&
              Number(item?.player_number) ===
                Number(filteredFile?.player_number),
          );
          console.log("filteredFilesToUpload", filteredFilesToUpload);
          // 3. удаляем файл
          const response = await fetch(
            this.apiBaseUrl + "/api/new_file/" + id,
            {
              method: "DELETE",
              headers: {
                accept: "application/json",
              },
            },
          );
          if (response.ok) {
            // 4. меняем позиции файлов, которые стояли после удалямого файла (позицию меняем на -1)
            for (let i = 0; i < filteredFilesToUpload?.length; i++) {
              const requestData = {
                id: filteredFilesToUpload[i]?.id,
                url: filteredFilesToUpload[i]?.url,
                type: filteredFilesToUpload[i]?.type,
                player_number: filteredFilesToUpload[i]?.player_number,
                count_play: filteredFilesToUpload[i]?.count_play,
                time_view: filteredFilesToUpload[i]?.time_view,
                position: filteredFilesToUpload[i]?.position - 1,
                panel_id: filteredFilesToUpload[i]?.panel_id,
              };

              await this.editFileRequest(requestData);
            }
          }
        }
      }

      // Инициализация интерфейса
      document.addEventListener("DOMContentLoaded", function () {
        // Инициализация медиаменеджера
        mediaManager = new MediaManager();
        window.mediaManager = mediaManager;

        // В main.js, после создания mediaManager, добавьте этот код:

        function getSelectedVideoWidgets() {
          const selectedWidgets = window.editorFrame.getSelected();
          return selectedWidgets.filter(
            (widget) =>
              widget.constructor &&
              (widget.constructor.name === "VideoWidget" ||
                (widget.widget &&
                  widget.widget.constructor &&
                  widget.widget.constructor.name === "VideoWidget")),
          );
        }
        function getSelectedAudioWidgets() {
          return window.editorFrame
            .getSelected()
            .filter(
              (widget) =>
                widget.type === "AudioPlayerWidget" ||
                widget.constructor?.name === "AudioPlayerWidget",
            );
        }

        window.onVideoWidgetSelectionChanged = function () {
          const selectedVideos = getSelectedVideoWidgets();

          console.log(`🎬 Выделено видеовиджетов: ${selectedVideos.length}`);

          if (selectedVideos.length === 1) {
            // Ровно один видеовиджет выбран - фильтруем по его номеру
            const playerNumber = selectedVideos[0].getPlayerNumber();
            console.log(`  → Фильтр по проигрывателю №${playerNumber}`);
            if (mediaManager) {
              mediaManager.filterByPlayerNumber(playerNumber, "visual");
            }
          } else {
            // Выбрано 0 или более 1 видеовиджетов - показываем все файлы
            console.log(
              `  → Показываем все файлы (выбрано: ${selectedVideos.length})`,
            );
            if (mediaManager) {
              mediaManager.filterByPlayerNumber(null);
            }
          }
        };

        window.onAudioWidgetSelectionChanged = function () {
          const selectedAudio = getSelectedAudioWidgets();
          if (selectedAudio.length === 1) {
            mediaManager?.filterByPlayerNumber(
              selectedAudio[0].getPlayerNumber(),
              "audio",
            );
          } else {
            mediaManager?.filterByPlayerNumber(null);
          }
        };

        window.onAudioWidgetSelected = function (audioWidget) {
          mediaManager?.filterByPlayerNumber(
            audioWidget.getPlayerNumber(),
            "audio",
          );
        };

        // Глобальный обработчик выбора видеовиджета
        window.onVideoWidgetSelected = function (videoWidget) {
          console.log(
            "🎬 Выбран видеовиджет с номером:",
            videoWidget.getPlayerNumber(),
          );

          if (mediaManager) {
            mediaManager.filterByPlayerNumber(
              videoWidget.getPlayerNumber(),
              "visual",
            );
          }
        };

        // Глобальный обработчик сброса фильтра (когда ни один виджет не выбран)
        window.onVideoWidgetDeselected = function () {
          console.log("🎬 Видеовиджет не выбран, показываем все файлы");

          if (mediaManager) {
            mediaManager.filterByPlayerNumber(null);
          }
        };

        // Tab switching functionality
        const tabs = document.querySelectorAll(".sidebar-tab");
        const tabContents = document.querySelectorAll(".tab-content");

        const tabTitles = {
          layout: "",
          themes: "",
          background: "",
          widgets: "",
          tools: "",
          media: "",
        };

        tabs.forEach((tab) => {
          tab.addEventListener("click", function () {
            const tabName = this.getAttribute("data-tab");

            // Update active tab
            tabs.forEach((t) => t.classList.remove("active"));
            this.classList.add("active");

            // Update active tab content
            tabContents.forEach((content) => {
              content.classList.remove("active");
              if (content.id === `tab-${tabName}`) {
                content.classList.add("active");
              }
            });

            console.log("Switched to tab:", tabName);
          });
        });

        // Panel toggle functionality
        const toggleWidgetsPanel = document.getElementById(
          "toggle-widgets-panel",
        );
        const widgetsPanel = document.getElementById("widgets-panel");

        toggleWidgetsPanel.addEventListener("click", function () {
          widgetsPanel.classList.toggle("collapsed");
          this.textContent = widgetsPanel.classList.contains("collapsed")
            ? "▶"
            : "×";
        });

        const toggleInspectorPanel = document.getElementById(
          "toggle-inspector-panel",
        );
        const inspectorPanel = document.getElementById("inspector-panel");

        toggleInspectorPanel.addEventListener("click", function () {
          inspectorPanel.classList.toggle("collapsed");
          this.textContent = inspectorPanel.classList.contains("collapsed")
            ? "◀"
            : "×";
        });

        // Section toggle functionality
        document.querySelectorAll(".section-title").forEach((title) => {
          title.addEventListener("click", function () {
            const targetId = this.getAttribute("data-target");
            const content = document.getElementById(targetId);
            const toggle = this.querySelector(".section-toggle");

            if (content.classList.contains("collapsed")) {
              content.classList.remove("collapsed");
              toggle.textContent = "−";
            } else {
              content.classList.add("collapsed");
              toggle.textContent = "+";
            }
          });
        });

        // Инициализируем все секции как свернутые
        document.querySelectorAll(".section-content").forEach((content) => {
          if (
            !content.id.includes("media") &&
            !content.id.includes("background-images")
          ) {
            // Не сворачиваем медиа-секции при инициализации
            content.classList.add("collapsed");
          }
        });

        // Initialize with widgets tab active
        document.querySelector('.sidebar-tab[data-tab="widgets"]').click();

        // Устанавливаем ID панели в тулбаре
        const panelId = document.getElementById("panel-id");
        const urlParams = new URLSearchParams(window.location.search);
        const fabricNumber = urlParams.get("fabric_number");
        if (panelId && fabricNumber) {
          panelId.innerHTML = `⚫ ПАНЕЛЬ FN${fabricNumber}`;
        }
      });

      // Функции для старого медиаплеера (сохранены для обратной совместимости)
      let mediaData = { audio: [], video: [] };
      let currentTrackIndex = 0;
      let currentMediaType = "audio";
      let currentPlayer = null;

      function showTab(tabName) {
        document.getElementById("audioTab").style.display =
          tabName === "audio" ? "block" : "none";
        document.getElementById("videoTab").style.display =
          tabName === "video" ? "block" : "none";
        document.querySelectorAll(".nav-link").forEach((link) => {
          link.classList.remove("active");
          if (
            (tabName === "audio" && link.textContent === "Аудио") ||
            (tabName === "video" && link.textContent === "Видео")
          ) {
            link.classList.add("active");
          }
        });
      }
    </script>
    <script>
      // Исправление для Grid Color Preview
      (function fixGridColorPicker() {
        // Функция для инициализации color picker для сетки
        function initGridColorPicker() {
          const gridColorInput = document.getElementById("grid-color");
          const gridColorPreview =
            document.getElementById("grid-color-preview");

          if (gridColorInput && gridColorPreview) {
            // Удаляем старые обработчики, если они были
            const newPreview = gridColorPreview.cloneNode(true);
            gridColorPreview.parentNode.replaceChild(
              newPreview,
              gridColorPreview,
            );
            const newInput = gridColorInput.cloneNode(true);
            gridColorInput.parentNode.replaceChild(newInput, gridColorInput);

            // Получаем новые элементы
            const finalPreview = document.getElementById("grid-color-preview");
            const finalInput = document.getElementById("grid-color");

            // Устанавливаем начальное значение
            finalPreview.style.backgroundColor = finalInput.value;
            const span = finalPreview.querySelector("span");
            if (span) span.textContent = finalInput.value;

            // Клик по превью открывает color picker
            finalPreview.addEventListener("click", function (e) {
              e.preventDefault();
              e.stopPropagation();
              finalInput.click();
            });

            // Обновление при выборе цвета
            finalInput.addEventListener("change", function (e) {
              const color = e.target.value;
              finalPreview.style.backgroundColor = color;
              const span = finalPreview.querySelector("span");
              if (span) span.textContent = color;

              // Здесь можно добавить вызов функции для обновления сетки на канвасе
              console.log("Grid color changed to:", color);
              if (window.editorFrame) window.editorFrame.setGridColor(color);
            });

            // Обновление в реальном времени
            finalInput.addEventListener("input", function (e) {
              const color = e.target.value;
              finalPreview.style.backgroundColor = color;
              const span = finalPreview.querySelector("span");
              if (span) span.textContent = color;
            });

            console.log("Grid color picker initialized");
          } else {
            console.log("Grid color elements not found, retrying in 500ms...");
            // Если элементы еще не загружены, пробуем снова через 500ms
            setTimeout(initGridColorPicker, 500);
          }
        }

        // Запускаем после полной загрузки DOM
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initGridColorPicker);
        } else {
          initGridColorPicker();
        }
      })();
    </script>
  </body>
</html>
