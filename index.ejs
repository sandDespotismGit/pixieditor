        // Добавьте метод для сброса фильтра
        resetFilter() {
          this.filterByPlayerNumber(null);
        }

        handleFileSelect(event) {
          const files = Array.from(event.target.files);
          if (files.length === 0) return;
          const audioExtensions = ["mp3", "wav", "ogg", "m4a", "flac", "aac"];
          const containsAudio = files.some((file) =>
            audioExtensions.includes(extractExtension(file.name).toLowerCase()),
          );
          const containsNonAudio = files.some(
            (file) =>
              !audioExtensions.includes(extractExtension(file.name).toLowerCase()),
          );

          if (this.currentPlayerType === "audio" && containsNonAudio) {
            showNotification("warning", "На аудиоплеер можно загрузить только аудио");
            event.target.value = "";
            return;
          }
          if (this.currentPlayerType !== "audio" && containsAudio) {
            showNotification("warning", "Аудио загружается только на аудиоплеер");
            event.target.value = "";
            return;
          }

          this.prepareFilesForUpload(files);
          this.uploadFile();
        }

        prepareFilesForUpload(files) {
          const fileInfo = document.getElementById("selected-file-info");
          const fileName = document.querySelector(".selected-file-name");
          const fileSize = document.querySelector(".selected-file-size");
          const uploadBtn = document.getElementById("upload-media");

          // Удаляем старый список файлов, если есть
          const oldFileList = fileInfo.querySelector(".file-list-preview");
          if (oldFileList) oldFileList.remove();

          if (files.length === 1) {
            // Если один файл - показываем его информацию
            fileName.textContent = files[0].name;
            fileSize.textContent = this.formatFileSize(files[0].size);
            fileInfo.classList.remove("multiple-files");
          } else {
            // Если несколько файлов - показываем количество и список
            fileName.textContent = `${files.length} файлов выбрано`;
            const totalSize = files.reduce((sum, file) => sum + file.size, 0);
            fileSize.textContent = this.formatFileSize(totalSize);
            fileInfo.classList.add("multiple-files");

            // Создаем список файлов
            const fileList = document.createElement("div");
            fileList.className = "file-list-preview";
            fileList.innerHTML = files
              .map((f) => `<div class="file-item">📄 ${f.name}</div>`)
              .join("");
            fileInfo.appendChild(fileList);
          }

          fileInfo.style.display = "block";
          uploadBtn.disabled = false;

          // Сохраняем файлы для загрузки
          this.filesToUpload = files;
        }

        formatFileSize(bytes) {
          if (bytes === 0) return "0 Bytes";
          const k = 1024;
          const sizes = ["Bytes", "KB", "MB", "GB"];
          const i = Math.floor(Math.log(bytes) / Math.log(k));
          return (
            parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + " " + sizes[i]
          );
        }

        async uploadFile() {
          if (!this.filesToUpload || this.filesToUpload.length === 0) return;
          if (!this.panelId) {
            showNotification(
              "error",
              "Нельзя загрузить медиа: panel_id не найден в URL",
            );
            return;
          }
          const uploadBtn = document.getElementById("upload-media");
          const progress = document.getElementById("upload-progress");
          const mediaType = document.getElementById("media-type").value;

          const player_number =
            this.currentPlayerFilter ??
            Number(
              document.getElementById("player-number-display")?.innerText,
            );
          if (mediaType !== "audio" && !Number.isFinite(player_number)) {
            showNotification(
              "warning",
              "Выберите видеопроигрыватель перед загрузкой файла",
            );
            return;
          }

          // Показываем прогресс
          uploadBtn.disabled = true;
          progress.style.display = "block";

          let uploadedCount = 0;
          const results = [];

          console.log("tottal_files", this.filesToUpload);

          for (let i = 0; i < this.filesToUpload?.length; i++) {
            const file = this.filesToUpload[i];
            const formData = new FormData();
            formData.append("file", file);
            const params = new URLSearchParams();

            const extension = extractExtension(file.name);
            console.log("ext", extension);

            const fileExtension = extension.toLowerCase();
            let fileMediaType = mediaType;

            // Автоматически определяем тип, если не выбран явно
            if (
              ["mp4", "avi", "mov", "wmv", "flv", "mkv"].includes(fileExtension)
            ) {
              fileMediaType = "video";
            } else if (
              ["mp3", "wav", "ogg", "m4a", "flac"].includes(fileExtension)
            ) {
              fileMediaType = "audio";
            } else if (
              ["jpg", "jpeg", "png", "gif", "bmp", "webp"].includes(
                fileExtension,
              )
            ) {
              fileMediaType = "image";
            }

            // 1. получаем все файлы
            const responseFiles = await fetch(
              this.apiBaseUrl + "/api/new_file/" + this.panelId,
              {
                method: "GET",
                headers: {
                  accept: "application/json",
                },
              },
            );

            const result = await responseFiles.json();

            // 2. фильтруем файлы по типу
            const filtered = result?.filter(
              (item) =>
                item?.type === fileMediaType &&
                Number(item?.player_number) === Number(player_number),
            );

            // 4. затем вставляем новый файл на 1 позицию
            try {
              // формат (аудио, видео, изображения)
              params.append("type", fileMediaType);
              // номер проигрывателя
              if (fileMediaType !== "audio") {
                params.append("player_number", Number(player_number));
              }
              // количество проигрываний (мультиплексор)
              params.append("count_play", 1);
              // время показа
              if (fileMediaType == "image") {
                params.append("time_view", 10);
              } else params.append("time_view", 0);
              // позиция в плейлисте
              params.append("position", 1);
              // id панели
              params.append("panel_id", this.panelId);

              const response = await fetch(
                this.apiBaseUrl +
                  "/api/new_file/" +
                  this.panelId +
                  "/upload-files?" +
                  params,
                {
                  method: "POST",
                  headers: {
                    accept: "application/json",
                  },
                  body: formData,
                },
              );

              if (response.ok) {
                // 3. сначала увеличиваем все позиции на +1
                for (let i = 0; i < filtered?.length; i++) {
                  const requestData = {
                    id: filtered[i]?.id,
                    url: filtered[i]?.url,
                    type: filtered[i]?.type,
                    player_number: filtered[i]?.player_number,
                    count_play: filtered[i]?.count_play,
                    time_view: filtered[i]?.time_view,
                    position: filtered[i]?.position + 1,
                    panel_id: filtered[i]?.panel_id,
                  };
                  console.log("filter", requestData);
                  await this.editFileRequest(requestData);
                }
              }
            } catch (e) {}
          }

          // Завершаем загрузку
          setTimeout(async () => {
            progress.style.display = "none";
            uploadBtn.disabled = false;

            // Очищаем форму
            document.getElementById("media-file").value = "";
            document.getElementById("selected-file-info").style.display =
              "none";
            this.filesToUpload = null;

            // Сбрасываем параметры к значениям по умолчанию
            this.currentShowTime = 10;
            this.currentMultiplexor = 1;
            this.updateShowTimeDisplay();
            this.updateMultiplexorDisplay();
            this.updatePlayerNumberDisplay();
          }, 500);

          await this.loadMediaFiles();
        }

        selectAndPlayMediaInPanel() {
          if (!this.currentMedia) return;

          const audioPlayer = document.getElementById("audio-player");
          const videoPlayer = document.getElementById("video-player");

          // Скрываем всех
          audioPlayer.style.display = "none";
          videoPlayer.style.display = "none";

          // Настраиваем соответствующий плеер
          if (this.currentMedia.type === "audio") {
            audioPlayer.src = this.currentMedia.url;
            audioPlayer.style.display = "block";
            audioPlayer
              .play()
              .catch((e) => console.error("Ошибка воспроизведения:", e));
          } else if (this.currentMedia.type === "video") {
            videoPlayer.src = this.currentMedia.url;
            videoPlayer.style.display = "block";
