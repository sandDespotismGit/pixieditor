                  <!-- СКРИПТ ДЛЯ КНОПОК ФИЛЬТРАЦИИ (обновлен для 26 слайдов) -->
                  <script>
                    window.showAllBackgrounds = function (e) {
                      if (e) e.stopPropagation();

                      const allBtn = document.getElementById("bg-show-all");
                      const landBtn =
                        document.getElementById("bg-show-landscape");
                      const portBtn =
                        document.getElementById("bg-show-portrait");

                      if (allBtn) {
                        allBtn.classList.add("btn-primary");
                        allBtn.style.background = "var(--accent-primary)";
                      }
                      if (landBtn) {
                        landBtn.classList.remove("btn-primary");
                        landBtn.style.background = "var(--bg-tertiary)";
                      }
                      if (portBtn) {
                        portBtn.classList.remove("btn-primary");
                        portBtn.style.background = "var(--bg-tertiary)";
                      }

                      const track =
                        document.getElementById("bg-carousel-track");
                      const totalSlidesSpan =
                        document.getElementById("bg-total-slides");

                      if (track) {
                        for (let i = 0; i < track.children.length; i++) {
                          track.children[i].style.display = "flex";
                        }
                        if (totalSlidesSpan) {
                          totalSlidesSpan.textContent = track.children.length;
                        }
                      }

                      setTimeout(() => {
                        const firstDot = document.querySelector(
                          '.carousel-dot[data-index="0"]',
                        );
                        if (firstDot) firstDot.click();
                      }, 50);
                    };

                    window.showLandscapeBackgrounds = function (e) {
                      if (e) e.stopPropagation();

                      const allBtn = document.getElementById("bg-show-all");
                      const landBtn =
                        document.getElementById("bg-show-landscape");
                      const portBtn =
                        document.getElementById("bg-show-portrait");

                      if (allBtn) {
                        allBtn.classList.remove("btn-primary");
                        allBtn.style.background = "var(--bg-tertiary)";
                      }
                      if (landBtn) {
                        landBtn.classList.add("btn-primary");
                        landBtn.style.background = "var(--accent-primary)";
                      }
                      if (portBtn) {
                        portBtn.classList.remove("btn-primary");
                        portBtn.style.background = "var(--bg-tertiary)";
                      }

                      // Горизонтальные: все JPG (исключаем PNG)
                      const track =
                        document.getElementById("bg-carousel-track");
                      const totalSlidesSpan =
                        document.getElementById("bg-total-slides");

                      if (track) {
                        let visibleCount = 0;
                        let firstVisible = -1;

                        for (let i = 0; i < track.children.length; i++) {
                          const img = track.children[i].querySelector("img");
                          // Горизонтальные: bg-3,4,5,6,7,8,11,14,15,16,17,19,21,22,23,24,26
                          const landscapeIds = [
                            "bg-3",
                            "bg-4",
                            "bg-5",
                            "bg-6",
                            "bg-7",
                            "bg-8",
                            "bg-11",
                            "bg-14",
                            "bg-15",
                            "bg-16",
                            "bg-17",
                            "bg-19",
                            "bg-21",
                            "bg-22",
                            "bg-23",
                            "bg-24",
                            "bg-26",
                          ];

                          if (img && landscapeIds.includes(img.id)) {
                            track.children[i].style.display = "flex";
                            visibleCount++;
                            if (firstVisible === -1) firstVisible = i;
                          } else {
                            track.children[i].style.display = "none";
                          }
                        }

                        if (totalSlidesSpan) {
                          totalSlidesSpan.textContent = visibleCount;
                        }

                        if (firstVisible !== -1) {
                          const dot = document.querySelector(
                            `.carousel-dot[data-index="${firstVisible}"]`,
                          );
                          if (dot) dot.click();
                        }
                      }
                    };

                    window.showPortraitBackgrounds = function (e) {
                      if (e) e.stopPropagation();

                      const allBtn = document.getElementById("bg-show-all");
                      const landBtn =
                        document.getElementById("bg-show-landscape");
                      const portBtn =
                        document.getElementById("bg-show-portrait");

                      if (allBtn) {
