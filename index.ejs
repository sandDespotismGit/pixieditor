      // Получаем ID панели из URL
      function getPanelId() {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get("panel_id");
      }

      // Получаем базовый URL API
      function getApiBaseUrl() {
        return "https://admin.i-panel.pro:8787";
      }

      // Показ уведомления
      function showNotification(type, message) {
        const notification = document.createElement("div");
        notification.className = `notification notification-${type}`;
        notification.innerHTML = `
          <div class="notification-icon">
            ${type === "success" ? "✅" : type === "error" ? "❌" : type === "warning" ? "⚠️" : "ℹ️"}
          </div>
          <div class="notification-message">${message}</div>
        `;

        document.body.appendChild(notification);

        setTimeout(() => {
          notification.style.animation = "slideOutRight 0.2s ease-out";
          setTimeout(() => notification.remove(), 200);
        }, 3000);
      }

      // Функции для парсинга имени файла с временем показа и мультиплексором
      function extractShowTimeFromFilename(filename) {
        // Ищем паттерн ###число### в имени файла для времени показа
        const timeMatch = filename.match(/###(\d+)###/);
        if (timeMatch && timeMatch[1]) {
          return parseInt(timeMatch[1], 10);
        }
        // Если параметров нет, возвращаем 10 секунд по умолчанию
        return 10;
      }

      function extractMultiplexorFromFilename(filename) {
        // Ищем второй паттерн ###число### в имени файла для мультиплексора
        const parts = filename.split("###");
        if (parts.length >= 3) {
          // Второй параметр - мультиплексор
          const multiplexorMatch = parts[2].match(/(\d+)/);
          if (multiplexorMatch && multiplexorMatch[1]) {
            return parseInt(multiplexorMatch[1], 10);
          }
        }
        // Если параметров нет, возвращаем 1 по умолчанию
        return 1;
      }

      function extractPlayerNumberFromFilename(filename) {
        // Ищем паттерн ###число### в имени файла для номера проигрывателя
        const parts = filename.split("###");
        if (parts.length >= 4) {
          // Третий параметр - номер проигрывателя (для видео)
          const playerMatch = parts[3].match(/(\d+)/);
          if (playerMatch && playerMatch[1]) {
            return parseInt(playerMatch[1], 10);
          }
        }
        // Если параметров нет, возвращаем 1 по умолчанию
        return 1;
      }

      function extractOriginalName(filename) {
        // Убираем все параметры из имени файла и возвращаем только имя без расширения
        const nameWithoutParams = filename.replace(/###\d+###/g, "");
        const lastDotIndex = nameWithoutParams.lastIndexOf(".");
        if (lastDotIndex !== -1) {
          return nameWithoutParams.substring(0, lastDotIndex);
        }
        return nameWithoutParams;
      }

      function extractExtension(filename) {
        // Извлекаем расширение файла (после последней точки)
        const parts = filename.split(".");
        return parts.length > 1 ? parts[parts.length - 1].toLowerCase() : "";
      }

      function formatFilenameWithParams(
        originalName,
        showTime,
        multiplexor,
        playerNumber = null,
        extension,
      ) {
        // Формируем имя файла в зависимости от типа
        if (playerNumber !== null) {
          // Видео файл: название###время###мультиплексор###проигрыватель###.расширение
          return `${originalName}###${showTime}###${multiplexor}###${playerNumber}###.${extension}`;
        } else {
          // Изображение или аудио: название###время###мультиплексор###.расширение
          return `${originalName}###${showTime}###${multiplexor}###.${extension}`;
        }
      }

      function hasParamsInFilename(filename) {
        // Проверяем, есть ли в имени файла параметры (паттерн ###число###)
        return /###\d+###/.test(filename);
      }

