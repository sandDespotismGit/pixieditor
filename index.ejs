        // В начале adjustPlayerNumber:
        adjustPlayerNumber(delta) {
          console.log(
            "adjustPlayerNumber CALLED, delta:",
            delta,
            "call stack:",
          );
          console.trace(); // Покажет, откуда пришел вызов

          let newValue = this.currentPlayerNumber + delta;
          if (newValue < 1) newValue = 1;
