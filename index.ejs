        adjustShowTime(delta) {
          let newValue = this.currentShowTime + delta;
          if (newValue < 1) newValue = 1;
          if (newValue > 999) newValue = 999;

          this.currentShowTime = newValue;
          this.updateShowTimeDisplay();
